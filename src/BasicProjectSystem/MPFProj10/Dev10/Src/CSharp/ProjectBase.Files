<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build"
  xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <ItemGroup>
    <Compile Include="$(ProjectBasePath)\*.cs">
      <Link>ProjectBase\blabla</Link>
      <Visible>true</Visible>
    </Compile>

    <Compile Include="$(ProjectBasePath)\Automation\*.cs">
      <Link>ProjectBase\Automation\blabla</Link>
      <Visible>true</Visible>
    </Compile>

    <Compile Include="$(ProjectBasePath)\Diagrams\**" LinkBase="ProjectBase\Diagrams">
      <Visible>true</Visible>
    </Compile>

    <Compile Include="$(ProjectBasePath)\Properties\**" LinkBase="ProjectBase\Properties">
      <Visible>true</Visible>
    </Compile>

    <None Include="$(ProjectBasePath)\Resources\**" LinkBase="ProjectBase\Resources">
      <Visible>true</Visible>
    </None>
  </ItemGroup>

</Project>